@@ -0,0 +1,390 @@
+# gptqmodel/nn_modules/qlinear/bpdq_torch.py
+
+import math
+import torch
+import torch.nn as nn
+from typing import List
+
+from . import BaseQuantLinear
+from ...models._const import DEVICE, PLATFORM
+from ...quantization.config import FORMAT, METHOD
+from ...utils.backend import BACKEND
+from ...adapter.adapter import Adapter
+
+
+# import importlib.util
+# import sys
+# so_path = "path/GPTQModel/lut_gemm_ext.cpython-312-x86_64-linux-gnu.so"
+# spec = importlib.util.spec_from_file_location("lut_gemm_ext", so_path)
+# if spec and spec.loader:
+#     lut_gemm_ext = importlib.util.module_from_spec(spec)
+#     sys.modules["lut_gemm_ext"] = lut_gemm_ext
+#     spec.loader.exec_module(lut_gemm_ext)
+# Please ref LUT-GEMM: https://arxiv.org/abs/2206.09557
+
+
+import triton
+import triton.language as tl
+_TORCH_TO_TRITON_DTYPE = {
+    torch.float16:  tl.float16,
+    torch.bfloat16: tl.bfloat16,
+}
+@triton.autotune(
+    configs=[
+        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 64}, num_warps=8, num_stages=3),
+        triton.Config({'BLOCK_M': 64,  'BLOCK_N': 64}, num_warps=4, num_stages=3),
+        triton.Config({'BLOCK_M': 32,  'BLOCK_N': 64}, num_warps=4, num_stages=3),
+        triton.Config({'BLOCK_M': 16,  'BLOCK_N': 64}, num_warps=2, num_stages=2),
+    ],
+    key=['M', 'N', 'K'],
+)
+@triton.jit
+def bpdq_kernel_v21(
+    # Pointers
+    x_ptr, B_ptr, alpha_ptr, bias_ptr, out_ptr, Linear_bias_ptr,
+    # Shapes
+    M, N, K,
+    # Strides
+    stride_xm, stride_xk,
+    stride_bk, stride_bb, stride_bn,
+    stride_ag, stride_ab, stride_an,
+    stride_bg, stride_bn_bias,
+    stride_om, stride_on, stride_ob,
+    # Meta-parameters
+    BLOCK_M:         tl.constexpr,
+    BLOCK_N:         tl.constexpr,
+    BLOCK_K:         tl.constexpr,   # == GROUP_SIZE
+    N_PLANES:        tl.constexpr,
+    HAS_LINEAR_BIAS: tl.constexpr,
+    OUTPUT_DTYPE:    tl.constexpr,
+):
+    tl.static_assert(BLOCK_K % 32 == 0, "BLOCK_K must be divisible by 32")
+
+    # pid / grid swizzle
+    pid = tl.program_id(axis=0)
+
+    num_pid_m = tl.cdiv(M, BLOCK_M)
+    num_pid_n = tl.cdiv(N, BLOCK_N)
+    GROUP_M   = 8
+    num_pid_in_group = GROUP_M * num_pid_n
+
+    group_id     = pid // num_pid_in_group
+    first_pid_m  = group_id * GROUP_M
+    group_size_m = tl.minimum(num_pid_m - first_pid_m, GROUP_M)
+
+    pid_in_group = pid % num_pid_in_group
+    pid_m = first_pid_m + (pid_in_group % group_size_m)
+    pid_n = pid_in_group // group_size_m
+
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)   # [BLOCK_M]
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)   # [BLOCK_N]
+    valid_m = offs_m < M
+    valid_n = offs_n < N
+
+    # FP32
+    accumulator = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+
+    x_ptr_base = x_ptr + offs_m[:, None].to(tl.int64) * stride_xm  # [BLOCK_M, 1]
+    bn      = offs_n.to(tl.int64) * stride_bn       # [BLOCK_N]  B 
+    an      = offs_n.to(tl.int64) * stride_an       # [BLOCK_N]  alpha 
+    bn_bias = offs_n.to(tl.int64) * stride_bn_bias  # [BLOCK_N]  bias 
+
+    shift_vals = tl.arange(0, 32)[:, None]          # [32, 1]
+    k_offsets  = tl.arange(0, 32)[None, :]          # [1, 32]
+
+    for k_block_start in range(0, K, BLOCK_K):
+        g = k_block_start // BLOCK_K  
+
+        bias_val = tl.load(bias_ptr + g * stride_bg + bn_bias, mask=valid_n, other=0.0).to(tl.float32)
+
+        if N_PLANES >= 1:
+            a0 = tl.load(alpha_ptr + g * stride_ag + 0 * stride_ab + an, mask=valid_n, other=0.0).to(tl.float32)
+        if N_PLANES >= 2:
+            a1 = tl.load(alpha_ptr + g * stride_ag + 1 * stride_ab + an, mask=valid_n, other=0.0).to(tl.float32)
+        if N_PLANES >= 3:
+            a2 = tl.load(alpha_ptr + g * stride_ag + 2 * stride_ab + an, mask=valid_n, other=0.0).to(tl.float32)
+        if N_PLANES >= 4:
+            a3 = tl.load(alpha_ptr + g * stride_ag + 3 * stride_ab + an, mask=valid_n, other=0.0).to(tl.float32)
+
+        k_tile_base = k_block_start // 32 
+
+        for t in tl.static_range(0, BLOCK_K // 32):
+            k_tile  = k_tile_base + t
+            k_start = k_block_start + t * 32
+
+            k_range = (k_start + k_offsets).to(tl.int64)             # [1, 32]
+            x_chunk = tl.load(x_ptr_base + k_range * stride_xk, mask=valid_m[:, None], other=0.0)       # [BLOCK_M, 32]
+
+            w = tl.zeros((32, BLOCK_N), dtype=tl.float32)            # [32, BLOCK_N]
+
+            if N_PLANES >= 1:
+                p0 = tl.load(B_ptr + k_tile * stride_bk + 0 * stride_bb + bn, mask=valid_n, other=0)    # [BLOCK_N] int32
+                w += ((p0[None, :] >> shift_vals) & 1).to(tl.float32) * a0[None, :]
+
+            if N_PLANES >= 2:
+                p1 = tl.load(B_ptr + k_tile * stride_bk + 1 * stride_bb + bn, mask=valid_n, other=0)
+                w += ((p1[None, :] >> shift_vals) & 1).to(tl.float32) * a1[None, :]
+
+            if N_PLANES >= 3:
+                p2 = tl.load(B_ptr + k_tile * stride_bk + 2 * stride_bb + bn, mask=valid_n, other=0)
+                w += ((p2[None, :] >> shift_vals) & 1).to(tl.float32) * a2[None, :]
+
+            if N_PLANES >= 4:
+                p3 = tl.load(B_ptr + k_tile * stride_bk + 3 * stride_bb + bn, mask=valid_n, other=0)
+                w += ((p3[None, :] >> shift_vals) & 1).to(tl.float32) * a3[None, :]
+
+            w += bias_val[None, :]         # [32, BLOCK_N] fp32
+
+            accumulator = tl.dot(
+                x_chunk,                   # [BLOCK_M, 32]  bf16
+                w.to(OUTPUT_DTYPE),        # [32, BLOCK_N]  bf16
+                acc=accumulator,           # [BLOCK_M, BLOCK_N] fp32，
+            )
+
+    # Linear bias
+    if HAS_LINEAR_BIAS:
+        out_b = tl.load(Linear_bias_ptr + offs_n.to(tl.int64) * stride_ob, mask=valid_n, other=0.0).to(tl.float32)
+        accumulator += out_b[None, :]
+
+    out_ptrs = (out_ptr + offs_m[:, None].to(tl.int64) * stride_om + offs_n[None, :].to(tl.int64) * stride_on)
+    tl.store(out_ptrs, accumulator.to(OUTPUT_DTYPE), mask=valid_m[:, None] & valid_n[None, :],)
+
+
+
+class BPDQTorchLinear(BaseQuantLinear):
+    SUPPORTS_BACKENDS = [BACKEND.TORCH]
+    SUPPORTS_METHODS = [METHOD.BPDQ]            # Corresponds to METHOD.BPDQ in config.py
+    SUPPORTS_FORMATS = {FORMAT.BPDQ: 10}        # Corresponds to FORMAT.BPDQ in config.py
+    
+    SUPPORTS_BITS = [2, 3, 4, 6, 8, 10, 12, 14, 16]
+    SUPPORTS_GROUP_SIZE = [32, 64, 128, 256] 
+    SUPPORTS_DESC_ACT = [False]
+    SUPPORTS_SYM = [True, False]
+    SUPPORTS_SHARDS = True
+    SUPPORTS_TRAINING = False
+    SUPPORTS_AUTO_PADDING = False
+    SUPPORTS_IN_FEATURES_DIVISIBLE_BY = [32]    # Required by BPDQ LUT-GEMM
+    SUPPORTS_OUT_FEATURES_DIVISIBLE_BY = [1]
+    SUPPORTS_DEVICES = [DEVICE.ALL]
+    SUPPORTS_PLATFORM = [PLATFORM.ALL]
+    SUPPORTS_PACK_DTYPES = [torch.int32]     
+    SUPPORTS_ADAPTERS = [] 
+    SUPPORTS_DTYPES = [torch.float16, torch.bfloat16]
+    
+    REQUIRES_FORMAT_V2 = False
+    QUANT_TYPE = "bpdq"
+
+    def __init__(self, bits: int, group_size: int, sym: bool, desc_act: bool, in_features: int, out_features: int, 
+                    bias: bool = False, pack_dtype: torch.dtype = torch.int32, c_type = torch.bfloat16, adapter: Adapter = None, register_buffers: bool = True, **kwargs,):
+        self.msbits = kwargs.get("msbits", 4)
+        self.c_type = c_type 
+        # super().__init__(register_buffers=False skips the parent class's default GPTQ buffer registration
+        super().__init__(bits=bits, group_size=group_size, sym=sym, desc_act=desc_act, in_features=in_features, out_features=out_features, 
+                            bias=bias, pack_dtype=pack_dtype, backend=kwargs.pop("backend", BACKEND.TORCH), adapter=adapter, register_buffers=False, **kwargs)
+        
+        if register_buffers:    # Only register BPDQ-specific buffers (c, B, bias)
+            k = self.msbits
+            num_column_groups = math.ceil(self.in_features / self.group_size)
+            c_shape = (num_column_groups, k + 1, self.out_features)
+            in_feat_padded = self.in_features
+            if self.group_size == 256 and (in_feat_padded % 256 != 0):
+                in_feat_padded = ((in_feat_padded + 256 - 1) // 256) * 256 
+            b_shape = (in_feat_padded // 32, k, self.out_features)
+
+            # Visible to writer.py for direct Safetensors export! NOTE: c_type defaults to bf16
+            self.register_buffer("c", torch.zeros(c_shape, dtype=self.c_type))
+            self.register_buffer("B", torch.zeros(b_shape, dtype=torch.int32))
+            
+            if bias:
+                self.register_buffer("bias", torch.zeros(self.out_features, dtype=self.c_type))
+            else:
+                self.bias = None
+
+
+    # Override list_buffers for device offloading and fetching
+    def list_buffers(self) -> List:
+        buf = []
+        if hasattr(self, "c") and self.c is not None:
+            buf.append(self.c)
+        if hasattr(self, "B") and self.B is not None:
+            buf.append(self.B)
+        if hasattr(self, "bias") and self.bias is not None:
+            buf.append(self.bias)
+        return buf
+
+
+    # Minimal pack interface to receive the processor's payload
+    def pack(self, linear: nn.Module, c: torch.Tensor = None, B: torch.Tensor = None, **kwargs):
+        """ Receives c and B matrices from the quantization loop and registers them as buffers."""
+        if c is not None and B is not None:
+            self.register_buffer("c", c)  # Saved using the model's actual dtype; inference ideally uses external args (defaults to c_type = torch.bfloat16)
+            self.register_buffer("B", B)
+
+        if getattr(linear, "bias", None) is not None:
+            b = linear.bias.detach().to(device="cpu", dtype=self.c_type).contiguous()
+            self.register_buffer("bias", b)
+            # if isinstance(getattr(self, "_buffers", None), dict) and isinstance(self._buffers.get("bias", None), torch.Tensor):
+            #     self._buffers["bias"].copy_(b)
+            # else:
+            #     self.register_buffer("bias", b)
+        else:
+            if isinstance(getattr(self, "_buffers", None), dict):
+                self._buffers.pop("bias", None)
+            self.bias = None
+
+
+    # Hide BPDQ pack/unpack logic internally
+    def _unpack_lutgemm_int32(self, packed_int32: torch.Tensor, original_k: int):
+        K_tiles, Bits, M = packed_int32.shape
+        shifts = torch.arange(32, device=packed_int32.device, dtype=torch.int32).view(1, 1, 1, 32)
+        packed_expanded = packed_int32.unsqueeze(-1)
+        unpacked_bits = (packed_expanded >> shifts) & 1         # [K_tiles, Bits, M, 32]
+
+        # Target: [Bits, M, K_tiles, 32] -> [Bits, M, Total_K]
+        unpacked_permuted = unpacked_bits.permute(1, 2, 0, 3)
+        
+        B_restored = unpacked_permuted.contiguous().reshape(Bits, M, K_tiles * 32)
+        if B_restored.shape[2] > original_k:
+            B_restored = B_restored[:, :, :original_k]
+            
+        return B_restored 
+
+
+    def _forward_python_ref(self, x_in):
+        K_eff = x_in.shape[1] 
+        B_unpacked  = self._unpack_lutgemm_int32(self.B, K_eff).to(x_in.dtype)                          # [Bits, M, K_eff]
+        alpha       = self._lut_alpha.to(x_in.dtype)                                                    # [Groups, Bits, M]
+        bplane_bias = self._lut_bias.to(x_in.dtype)                                                     # [Groups, M]
+
+        col_group       = torch.arange(K_eff, device=x_in.device, dtype=torch.long) // self.group_size  # [K_eff]
+        alpha_k         = alpha.index_select(0, col_group).permute(1, 2, 0).contiguous()                # [Bits, M, K_eff]
+        bplane_bias_k   = bplane_bias.index_select(0, col_group).t().contiguous()                       # [M, K_eff]
+
+        W_recon = (B_unpacked.float() * alpha_k.float()).sum(dim=0) + bplane_bias_k.float()             # [M, K_eff]
+        out = x_in.float().matmul(W_recon.t())
+        if getattr(self, "bias", None) is not None:
+            out = out + self.bias.to(device=out.device, dtype=out.dtype) 
+        return out.to(x_in.dtype)
+
+
+    def forward(self, x: torch.Tensor):
+        out_shape = x.shape[:-1] + (self.out_features,)
+        x = x.reshape(-1, x.shape[-1])
+
+
+        ref_flag = False 
+
+
+        if hasattr(self, "B") and self.B.dtype == torch.int32:
+            input_dtype = x.dtype
+            if input_dtype != self.c_type:
+                x_in = x.to(self.c_type).contiguous()
+            else:
+                x_in = x.contiguous()
+
+            cache_key = (self.c.device, self.c.dtype)
+            if getattr(self, "_lut_cache_key", None) != cache_key:
+                self._lut_alpha = self.c[:, :-1, :].contiguous()
+                self._lut_bias  = self.c[:, -1,  :].contiguous()
+                raw_bias = getattr(self, "bias", None)
+                if raw_bias is not None:
+                    self._cached_linear_bias = raw_bias.contiguous()
+                    self._cached_ob_stride   = self._cached_linear_bias.stride(0)
+                else:
+                    self._cached_linear_bias = None
+                    self._cached_ob_stride   = 0
+                self._lut_cache_key = cache_key
+
+
+            total_tokens = x_in.shape[0]
+            if False: # LUT-GEMM Kernel
+            # if total_tokens == 1: 
+                M, K = x_in.shape
+                # assert K % self.group_size == 0, f"K {K} must be divisible by group_size {self.group_size}"
+                # assert self.group_size % 32 == 0
+
+                # args = [x_in,               # x
+                #     self.B,                 # B
+                #     self._lut_alpha,        # alpha
+                #     self._lut_bias,         # quant bias
+                #     self.group_size,        # group_size
+                #     self.bpdq_k_bits,       # num_bits
+                #     0,                      # m_tile_size (0=Auto)
+                #     0                       # num_threads (0=Auto)
+                # ]
+                # if self._cached_linear_bias is not None:
+                #     args.append(self._cached_linear_bias)
+                # out_fp32 = lut_gemm_ext.forward(*args)
+                # out = out_fp32.to(x_in.dtype)
+            else:     
+                M, K = x_in.shape
+                _, _, N = self.B.shape
+
+                assert K % self.group_size == 0, f"K={K} must be divisible by group_size={self.group_size}"
+                assert K % 32 == 0, "K must be divisible by 32 (bit-tile requirement)"
+
+                out = torch.empty((M, N), device=x_in.device, dtype=self.c_type)
+                has_linear_bias = (self._cached_linear_bias is not None)
+                stride_ob       = self._cached_ob_stride
+                linear_bias = self._cached_linear_bias if has_linear_bias else out
+                grid = lambda META: (triton.cdiv(M, META['BLOCK_M']) * triton.cdiv(N, META['BLOCK_N']),)
+                output_dtype_tl = _TORCH_TO_TRITON_DTYPE[self.c_type]
+
+                bpdq_kernel_v21[grid](
+                    # Pointers
+                    x_in, self.B, self._lut_alpha, self._lut_bias, out, linear_bias,
+                    # Shapes
+                    M, N, K,
+                    # Strides
+                    x_in.stride(0), x_in.stride(1),
+                    self.B.stride(0), self.B.stride(1), self.B.stride(2),
+                    self._lut_alpha.stride(0), self._lut_alpha.stride(1), self._lut_alpha.stride(2),
+                    self._lut_bias.stride(0),  self._lut_bias.stride(1),
+                    out.stride(0), out.stride(1), stride_ob,
+                    BLOCK_K=self.group_size,                # GROUP_SIZE
+                    N_PLANES=self.msbits,
+                    HAS_LINEAR_BIAS=has_linear_bias,
+                    OUTPUT_DTYPE=output_dtype_tl
+                )
+
+
+            if ref_flag and hasattr(self, "_forward_python_ref"):
+                name = getattr(self, "name", self.__class__.__name__)
+                out_ref = self._forward_python_ref(x_in)
+                out_f = out.float()
+                ref_f = out_ref.float()
+                diff = (out_f - ref_f).abs()
+
+                same_inf = torch.isinf(out_f) & torch.isinf(ref_f) & (torch.sign(out_f) == torch.sign(ref_f))
+                diff = diff.masked_fill(same_inf, 0.0)
+
+                nan_in  = torch.isnan(x_in).any().item()
+                inf_in  = torch.isinf(x_in).any().item()
+                nan_out = torch.isnan(out).any().item()
+                inf_out = torch.isinf(out).any().item()
+                nan_ref = torch.isnan(out_ref).any().item()
+                inf_ref = torch.isinf(out_ref).any().item()
+                if nan_in or inf_in or nan_out or inf_out or nan_ref or inf_ref:
+                    print(f"[{name}] NON-FINITE ||in(nan={nan_in},inf={inf_in}) ||out(nan={nan_out},inf={inf_out}) ||ref(nan={nan_ref},inf={inf_ref})"
+                          f"max|in|={x_in.abs().max().item():.3e}|| max|out|={out.abs().max().item():.3e}|| max|ref|={out_ref.abs().max().item():.3e}")
+
+                # nan-safe mean/max
+                diff_f = diff.float()
+                mask = ~torch.isnan(diff_f)
+                if mask.any():
+                    mean_diff = diff_f[mask].mean().item()
+                    max_diff  = diff_f[mask].max().item()
+                else:
+                    mean_diff = float("nan")
+                    max_diff  = float("nan")
+                status = "✅ MATCH" if (mean_diff == mean_diff and mean_diff < 1e-2) else "⚠️  MISMATCH"
+                print(f"[{name}] tk={x_in.shape[0]} | MeanDiff: {mean_diff:.5f} MaxDiff: {max_diff:.5f} {status}")
+
+            if input_dtype != self.c_type:
+                out = out.to(input_dtype)   
+        else:
+            out = self._forward(x, out_shape)
+
+        return out.reshape(out_shape)
+    
+
