+def _materialize_meta_weights(model: PreTrainedModel, device: str = "cpu") -> None:
+
+    has_meta = any(
+        p.device.type == "meta"
+        for p in model.parameters()
+    )
+    if not has_meta:
+        return  
+
+    model_path = getattr(model.config, "_name_or_path", None)
+    if not model_path or not os.path.isdir(model_path):
+        raise RuntimeError(
+            f"rotate_model: detected meta tensors, but failed to locate the model files.\n"
+            f"  model.config._name_or_path = '{model_path}'\n"
+            f"  Please make sure the model is loaded from a local directory, "
+            f"or load the weights manually before rotation."
+        )
+    log.info(f"rotate_model: meta tensors detected, materializing weights from local path: {model_path}")
+    try:
+        from accelerate import load_checkpoint_in_model
+        load_checkpoint_in_model(
+            model,
+            checkpoint=model_path,
+            device_map={"": device},
+        )
+        log.info("rotate_model: weight materialization completed")
+    except Exception as exc:
+        raise RuntimeError(
+            f"rotate_model: failed to materialize meta tensors: {exc}\n"
+            f"  checkpoint path: {model_path}"
+        ) from exc
 
