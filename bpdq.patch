+++ b/gptqmodel/quantization/bpdq.py
@@ -0,0 +1,418 @@
+# gptqmodel/quantization/bpdq.py
+
+import math
+import time
+import threading
+import torch
+import torch.nn as nn
+import transformers
+
+from .gptq import GPTQ
+from .quantizer import Quantizer
+from ..utils.logger import setup_logger
+from .gar import compute_local_perms, compute_global_perm, compose_final_perm, invert_perm
+
+log = setup_logger()
+
+
+def analysis_diff(original, approximation):
+    original_f = original.float()
+    approximation_f = approximation.float()
+    norm_original = torch.linalg.norm(original_f)
+    if norm_original == 0:
+        return 0.0
+    norm_diff = torch.linalg.norm(original_f - approximation_f)
+    rel_err_x_vs_wq = (norm_diff / norm_original).item()
+    return rel_err_x_vs_wq
+
+
+class BPDQuantizer(Quantizer):
+
+    def bit_plane_decomposition(self, q, bits: int):
+        w_int = q.to(torch.int32)
+        planes = [((w_int >> i) & 1).to(torch.uint8) for i in range(bits)]
+        return torch.stack(planes, dim=0)  # [bits, B, G] uint8
+
+    def solve_C(self, W_target, basis_plane, U_loc, num_plane, alpha=1e-4, dtype_store=torch.float32, dtype_acc=torch.float32):
+        device = W_target.device
+        B, group_size = W_target.shape                                                 
+        n_features = num_plane + 1                                                           # k bit-planes + 1 bias term
+        ones_batched = torch.ones(B, group_size, 1, device=device, dtype=dtype_acc)          # Constant feature for bias (c0)
+        I = torch.eye(n_features, device=device, dtype=dtype_acc).expand(B, n_features, n_features)
+
+        # --- bit-planes (B), solve for coefficients (C) ---
+        b_stacked_u8 = basis_plane.permute(1, 2, 0)                                          # [B, group_size, num_plane]
+        X_batched = torch.cat((b_stacked_u8.to(dtype=dtype_acc), ones_batched), dim=2)       # [B, group_size, n_features]
+
+        U = U_loc.to(dtype=dtype_acc)   # Upper triangular Cholesky factor of the local inverse Hessian (Group)
+
+        # Pre-whiten X and Y using U^{-T} (avoids explicit matrix inversion)
+        # Pre-whiten X: Reshape to [G, B*n] for a single batched solve to avoid Python loops
+        X_rhs = X_batched.permute(1, 0, 2).reshape(group_size, B * n_features).contiguous()  # [G, B*n]
+        Xp_flat = torch.linalg.solve_triangular(U.transpose(0, 1), X_rhs, upper=False)       # solve(U^T, ·)
+        Xp = Xp_flat.reshape(group_size, B, n_features).permute(1, 0, 2).contiguous()        # [B,G,n]
+
+        # Pre-whiten Y (Target Weights)
+        Y_rhs = W_target.to(dtype_acc).transpose(0, 1).contiguous()                          # [G,B]
+        Yp_T = torch.linalg.solve_triangular(U.transpose(0, 1), Y_rhs, upper=False)          # [G,B]
+        Yp = Yp_T.transpose(0, 1).contiguous()   
+
+        XT = Xp.transpose(1, 2)     
+        XTX = XT @ Xp 
+        A = XTX + I * float(alpha)    
+        rhs = XT @ Yp.unsqueeze(-1)
+
+        # solve -> (fail row) lstsq
+        # current_C_fp32 = torch.linalg.solve(A, rhs)                # [B, n_features, 1]
+        sol, info = torch.linalg.solve_ex(A, rhs)                    # info == 0 means successful solve
+        if torch.any(info != 0):                     
+            bad = (info != 0)                                        # [B]
+            sol_bad = torch.linalg.lstsq(A[bad], rhs[bad]).solution  # Fallback to robust least squares (SVD/QR) for singular matrices
+            sol[bad] = sol_bad                                        
+        if not torch.isfinite(sol).all():
+            raise ValueError("Non-finite values (NaN or Inf) detected in solution C")
+
+        # NOTE Keep for reference
+        # error_groupwise_coeffs = analysis_diff(W_target, (X_batched @ sol).squeeze(-1))
+        # print(f"*BPD-ALS (k={num_plane})* init error: {error_groupwise_coeffs:.6f}")
+        
+        return sol.to(dtype_store)
+
+        # # ___ Improves ACC, but PPL higher ___
+        # diag_mean = XTX.diagonal(dim1=-2, dim2=-1).mean(dim=-1)
+        # diag_mean = diag_mean.clamp(min=1e-8)                           
+        # alpha_eff = (float(alpha) * diag_mean).view(-1, 1, 1)
+        # A = XTX + I * alpha_eff
+        # rhs = XT @ Yp.unsqueeze(-1)
+        # sol, info = torch.linalg.solve_ex(A, rhs)
+        # if torch.any(info != 0):
+        #     bad = (info != 0)
+        #     if bad.any():
+        #         sol_bad = torch.linalg.lstsq(A[bad], rhs[bad]).solution
+        #         sol[bad] = sol_bad
+        # if not torch.isfinite(sol).all():
+        #     raise ValueError("Non-finite values (NaN or Inf) detected in solution C")
+        # return sol.to(dtype_store)
+
+
+    def quantize_bpdq(
+        self,
+        W_target,   # shape [rows, G]
+        scales,     # match W_target shape, dims*batch, batch=group_size. (identical values per group/row)
+        zeros,      # match W_target shape
+
+        W_process, U_rows, U_loc, d_loc,
+
+        bplane_bits=8, msb_num=4, alpha=1e-4,
+        n_iters=5, candidate_vectors=None, candidate_vectors_float=None, 
+        dtype_store=torch.float32, dtype_acc=torch.float32
+    ):
+        # pid = os.getpid()
+        # tid = threading.get_ident()
+        device = W_target.device
+        rows, G = W_target.shape
+        tail_len = W_process.shape[1]
+
+        q = torch.clamp(torch.round(W_target / scales) + zeros, 0, 2**bplane_bits - 1)
+        # all_planes: [BITS, B, group_size]
+        all_planes = self.bit_plane_decomposition(q, bplane_bits) 
+        start_bit_index = bplane_bits - msb_num
+
+        c_store_iter = self.solve_C(W_target, all_planes[start_bit_index:], U_loc, 
+                                    num_plane=msb_num, alpha=alpha, dtype_store=dtype_store, dtype_acc=dtype_acc)
+        
+
+        # base W_process snapshot (avoid iterations wrong.)
+        base_processing = W_process.to(dtype_acc).contiguous()
+
+        results = None
+        results_score = torch.tensor(float("inf"), device=device, dtype=dtype_acc)
+        for it in range(n_iters):
+            # restore W_processing to same start
+            W_processing = base_processing.clone()
+
+            # 1) build v_cands (float) from c
+            C_coeffs = c_store_iter[:, :-1, 0].to(dtype_acc).contiguous()                   # [rows, k]
+            C_bias   = c_store_iter[:,  -1, 0].to(dtype_acc).contiguous()                   # [rows]
+            v_cands  = C_coeffs.matmul(candidate_vectors_float.t()) + C_bias.unsqueeze(1)   # [rows, ncand]
+
+            # 2) GPTQ-style, propagation on tail
+            k = msb_num
+            B_final = torch.empty((k, rows, G), device=device, dtype=torch.uint8)
+            Q_old   = torch.empty((rows, G), device=device, dtype=dtype_acc)                # quantized weight
+            E_old   = torch.empty((rows, G), device=device, dtype=dtype_acc)
+
+            for t in range(G):
+                y_col = W_processing[:, t]                                  # [rows]
+
+                diff = y_col.unsqueeze(1) - v_cands                         # [rows, ncand]
+                best_idx = diff.pow(2).argmin(dim=1)                        # [rows]
+
+                best_b = candidate_vectors[best_idx]                        # [rows, k]
+                B_final[:, :, t] = best_b.transpose(0, 1).contiguous()
+
+                q_col = v_cands.gather(1, best_idx.view(-1, 1)).squeeze(1)  # [rows]
+                Q_old[:, t] = q_col
+
+                err = (y_col - q_col) / d_loc[t]                            # Eq. (3)
+                E_old[:, t] = err
+
+                # propagate to tail: W_processing[:, t:] -= err * U_rows[t, t:]
+                U_seg = U_rows[t, t:tail_len].to(dtype_acc)                 # [tail_len - t]
+                W_processing[:, t:tail_len] = W_processing[:, t:tail_len] - err.unsqueeze(1) * U_seg.unsqueeze(0)
+
+                # keep exact q at position t
+                # W_processing[:, t] = q_col  # redundancy
+
+            # 3) refit c under U_loc metric with fixed B_final (prewhiten LS)
+            c_store = self.solve_C(W_target, B_final, U_loc, msb_num, alpha, dtype_store, dtype_acc)
+
+            # rebuild Q_new using inference-equivalent c_store
+            b_stacked = B_final.permute(1, 2, 0).to(dtype_acc)        # [rows, G, k]
+            ones = torch.ones(rows, G, 1, device=device, dtype=dtype_acc)
+            X = torch.cat([b_stacked, ones], dim=2)                   # [rows, G, k+1]
+            Q_new = (X @ c_store.to(dtype_acc)).squeeze(-1)           # [rows, G]
+
+            # delta-correction: ΔS U_loc = Q_old - Q_new
+            D = (Q_old - Q_new)                                       # [rows, G]
+
+            # Eq. (9) delta_E*U_{loc}=W_{old}-W_{new}
+            delta_E_T = torch.linalg.solve_triangular(U_loc.transpose(0, 1).to(dtype_acc), D.transpose(0, 1).contiguous(),upper=False,)
+            delta_E = delta_E_T.transpose(0, 1).contiguous()          # [rows, G]
+
+            # update E_group and tail to match new Q
+            E_new = E_old + delta_E                                   # Delta Correction
+
+            # overwrite group with Q_new (final)
+            W_processing[:, :G] = Q_new
+
+            # correct tail beyond group: W_processing[:, G:] -= ΔS @ U_rows[:, G:]
+            if tail_len > G:
+                W_processing[:, G:tail_len] = W_processing[:, G:tail_len] - delta_E.matmul(U_rows[:, G:tail_len].to(dtype_acc))
+
+            # "retaining the iterate that minimizes the group-wise propagation error ||E_{:,s:(s+g)}||.
+            # the reconstruct ERROR in Hessian
+            score = E_new.pow(2).sum()  # score by ||S_g||^2
+
+            if (results is None) or (score < results_score):  # solve_C → B-step → refit → delta
+                results_score = score
+                results = dict(W_processing=W_processing, Q_store=Q_new.to(dtype_store), E_group=E_new, B_final=B_final.clone(), c_store=c_store.clone())
+                # print(f"[pid={pid}|tid={tid}] iter={it+1}/{n_iters}||results_score={results_score.detach().item():.6e}")
+
+            # iterate c <- refit(c)
+            c_store_iter = c_store
+
+        return results
+
+
+
+class BPDQ(GPTQ):
+    def __init__(self, module: nn.Module, qcfg=None):
+        super().__init__(module, qcfg)
+        self._bpdq_candidate_cache = {}
+
+
+    def create_quantizer(self, name: str) -> Quantizer:
+        return BPDQuantizer(qcfg=self.qcfg, name=name)
+
+
+    def _get_bpdq_candidates(self, k: int, dtype: torch.dtype, device: torch.device):
+        if k <= 0:
+            return None, None
+        key = (int(k), dtype, device)
+        cached = self._bpdq_candidate_cache.get(key, None)
+        if cached is not None:
+            return cached
+
+        values = torch.tensor([0, 1], device=device, dtype=torch.uint8)
+        if k == 1:
+            candidate_vectors = values.view(-1, 1)
+        else:
+            candidate_vectors = torch.cartesian_prod(*([values] * k))
+
+        candidate_vectors_float = candidate_vectors.to(dtype=dtype)
+        self._bpdq_candidate_cache[key] = (candidate_vectors, candidate_vectors_float)
+        return candidate_vectors, candidate_vectors_float
+        # candidate_vectors (uint8) for fast storage, candidate_vectors_f (float) for matmul.
+
+
+    @torch.inference_mode()
+    def _pack_lutgemm_int32(self, B_batch: torch.Tensor):
+        Bits, M, GroupSize = B_batch.shape
+        if GroupSize % 32 != 0:
+            raise ValueError(f"LUT-GEMM requires GroupSize multiple of 32, got {GroupSize}")
+        B_int = B_batch.to(torch.int32).contiguous()                # .round().clamp(0, 1) maybe redundancy
+        B_reshaped = B_int.reshape(Bits, M, GroupSize // 32, 32)
+        B_permuted = B_reshaped.permute(2, 0, 1, 3)                 # [Bits, M, G_blocks, 32] -> [G_blocks, Bits, M, 32]
+        shifts = torch.arange(32, device=B_batch.device, dtype=torch.int32).view(1, 1, 1, 32)
+        packed_int32 = (B_permuted << shifts).sum(dim=-1, dtype=torch.int32)
+        return packed_int32.contiguous()
+
+
+    @torch.inference_mode()
+    def quantize(self, blocksize=128):
+        start = time.time()
+        target_device = getattr(self.module, "target_device", None)
+
+        assert self.qcfg.bpdq is not None, "BPDQConfig is required for BPDQ quantization."
+        assert self.qcfg.group_size in (32, 64, 128, 256), "BPDQ scheme requires group_size in {32, 64, 128, 256}."
+        assert self.columns % self.qcfg.group_size == 0, "columns must be multiple of group_size for BPDQ."
+        msb_num = self.qcfg.bpdq.msbits
+        n_iters = self.qcfg.bpdq.n_iters
+        alpha = self.qcfg.bpdq.alpha
+        group_size = self.qcfg.group_size
+        if blocksize < group_size:
+            blocksize = group_size   
+        is_rotated = (getattr(self.qcfg, "rotation", None) is not None)
+
+
+        self.finalize_hessian(target_device=target_device)
+        if self.module_copy is None:
+            W = self.clone_module(device=target_device)
+        else:
+            W = self.module_copy.to(device=target_device)
+            del self.module_copy
+        dead = torch.diag(self.H) == 0
+        self.H[dead, dead] = 1
+        W[:, dead] = 0
+
+        if is_rotated:
+            self.qcfg.act_group_aware = False    
+        else:
+            self.qcfg.act_group_aware = True    # Free lunch for BPDQ with better accuracy
+
+        if self.qcfg.act_group_aware:
+            diag_h = torch.diag(self.H)
+            local_perms, local_values = compute_local_perms(diag_h, group_size, return_values=True)
+            global_perm = compute_global_perm(diag_h, group_size, precomputed_values=local_values)
+            del local_values
+            final_perm = compose_final_perm(local_perms, global_perm, group_size)
+            W = W[:, final_perm]
+            self.H = self.H[final_perm][:, final_perm]
+
+        Hinv, damp = self.hessian_inverse(self.H)
+        if Hinv is None:
+            raise RuntimeError("BPDQ requires a non-None Hessian inverse (Hinv).")
+
+
+        c_list, B_list = [], []
+        Losses = torch.zeros_like(W)
+        Q = torch.zeros_like(W)
+
+        dtype_acc   = torch.float32  
+        dtype_store = torch.float32
+        # dtype_store = torch.bfloat16
+        candidate_vectors, candidate_vectors_float = self._get_bpdq_candidates(
+            k=msb_num, dtype=dtype_acc, device=target_device)
+
+
+
+        for i1 in range(0, self.columns, blocksize):
+            i2 = min(i1 + blocksize, self.columns)
+            count = i2 - i1
+
+            W1_acc = W[:, i1:i2].to(dtype_acc).clone()  
+            Q1 = torch.zeros((W.shape[0], count), dtype=dtype_store, device=target_device)
+            Losses1 = torch.zeros_like(W1_acc) 
+            Err1 = torch.zeros_like(W1_acc)
+
+            Hinv1 = Hinv[i1:i2, i1:i2].to(dtype_acc) 
+            d_diag = Hinv1.diagonal()
+
+            for g0 in range(0, count, group_size):
+                g1 = g0 + group_size
+                # self.quantizer.find_params(W[:, i1 + g0 : i1 + g1], weight=True)
+                self.quantizer.find_params(W1_acc[:, g0:g1], weight=True)
+                curr_scale = self.quantizer.scale.to(dtype_acc)
+                curr_zero  = self.quantizer.zero.to(dtype_acc)
+
+                W_target = W1_acc[:, g0:g1].contiguous().clone()        # Current target Weights
+                W_process = W1_acc[:, g0:count].contiguous().clone()    # W_process = Quantized Weights + Error propagation
+                # U_rows = torch.triu(Hinv1[g0:g1, g0:count])           # Eq. (4) W <- W - E*U_{l,l:}, U_{l,l:}=U_rows_local
+                U_rows = Hinv1[g0:g1, g0:count]                         # Eq. (4) W <- W - E*U_{l,l:}, U_{l,l:}=U_rows_local
+                d_loc = d_diag[g0:g1]                                   # Eq. (3): E=(W-W)/U_{l,l}, U_{l,l}=d_loc, i.e. error coordinate divisor
+
+                bpdq_results = self.quantizer.quantize_bpdq(
+                    W_target, curr_scale, curr_zero, W_process, U_rows,
+                    # U_loc=torch.triu(Hinv1[g0:g1, g0:g1])
+                    U_loc=Hinv1[g0:g1, g0:g1], d_loc=d_loc,
+                    bplane_bits=self.qcfg.bits, msb_num=msb_num, alpha=alpha,
+                    n_iters=n_iters, candidate_vectors=candidate_vectors, 
+                    candidate_vectors_float=candidate_vectors_float,
+                    dtype_store=dtype_store, dtype_acc=dtype_acc
+                )
+
+                W1_acc[:, g0:count] = bpdq_results["W_processing"]
+                Q1[:, g0:g1]        = bpdq_results["Q_store"]
+                Losses1[:, g0:g1]   = bpdq_results["E_group"].pow(2)
+                Err1[:, g0:g1]      = bpdq_results["E_group"]
+                B_final             = bpdq_results["B_final"]
+                c_store             = bpdq_results["c_store"]
+
+                if (c_store is not None) and (B_final is not None):
+                    if self.qcfg.act_group_aware:
+                        perm_group_idx = (i1 + g0) // group_size
+                        orig_group_idx = int(global_perm[perm_group_idx].item())
+                        lp = local_perms[orig_group_idx].to(dtype=torch.long)
+                        inv_lp = torch.empty_like(lp)
+                        inv_lp[lp] = torch.arange(group_size, device=lp.device, dtype=torch.long)
+                        B_store = B_final.index_select(dim=2, index=inv_lp)
+                    else:
+                        B_store = B_final
+                        
+                    B_packed_chunk = self._pack_lutgemm_int32(B_store)
+                    B_list.append(B_packed_chunk)
+                    c_list.append(c_store.permute(2, 1, 0))
+
+            Q[:, i1:i2] = Q1
+            Losses[:, i1:i2] = (Losses1 / 2).to(Losses.dtype)     
+            
+            # --- W update --- 
+            # Global Propagation
+            # corr_out = bpdq_results["E_group"].matmul(Hinv[i1 + count - group_size : i2, i2:].to(dtype_acc))
+            corr_out = Err1.matmul(Hinv[i1:i2, i2:].to(dtype_acc))
+            W[:, i2:] = (W[:, i2:].to(dtype_acc) - corr_out).to(W.dtype) 
+
+        # --- LOOP END ---
+        avg_loss = torch.sum(Losses).item() / self.nsamples if self.nsamples != 0 else 0.0
+        del Losses
+        del Hinv
+        del self.H
+
+        if self.qcfg.act_group_aware:
+            # recovery Q order
+            inv_final = invert_perm(final_perm)
+            Q = Q[:, inv_final]
+
+            # recovery (c, B) order
+            inv_global_perm_list = invert_perm(global_perm).tolist()
+            c_list = [c_list[i] for i in inv_global_perm_list]
+            B_list = [B_list[i] for i in inv_global_perm_list]
+
+            del final_perm, inv_final, global_perm, local_perms
+
+        # c = torch.cat(c_list, dim=0).to(torch.float16)
+        c = torch.cat(c_list, dim=0).to(self.module.weight.dtype)
+        B = torch.cat(B_list, dim=0) 
+
+
+        if self._tp_pad_cols:
+            valid_cols = self._original_columns
+            Q = Q[:, :valid_cols]
+
+        if isinstance(self.module, transformers.Conv1D):
+            Q = Q.t()
+
+        if Q.shape != self.module.weight.shape:
+            Q = Q.reshape(self.module.weight.shape).to(self.module.weight.dtype)
+        else:
+            Q = Q.to(self.module.weight.dtype)
+
+        Q = Q.to(device=self.module.weight.data.device, non_blocking=False)
+        duration = time.time() - start
+
+        # quant_payload, dock to gptq_processor.py
+        quant_payload = {"c": c, "B": B}
+        return Q, quant_payload, duration, avg_loss, damp, self.nsamples
+
+__all__ = ["BPDQ"]
